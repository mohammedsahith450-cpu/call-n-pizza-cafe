# Call N Pizza Cafe - Environment Variables
# Copy this file to .env and provide your values.
# NEVER commit .env to GitHub.

# Public Supabase URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anon/Publishable Key (safe for client-side use with RLS enabled)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key-here
